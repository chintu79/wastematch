# WasteMatch environment configuration template (Issue #38).
# Copy to `.env` and fill in real values:  cp .env.example .env
# - Never commit a real `.env` file (excluded via .gitignore).
# - The backend validates these at startup and fails fast if critical
#   values are missing or invalid (see backend/app/config.py).
# - Development placeholders below are for local use only.

# --- Runtime ---
# One of: development | test | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (used by the `db` service and to build DATABASE_URL) ---
POSTGRES_USER=wastematch
POSTGRES_PASSWORD=password
POSTGRES_DB=wastematch

# Full SQLAlchemy connection string. Compose derives this automatically
# with `db` as the hostname; only needed when running the API outside
# Docker. Avoid URL-reserved characters (: @ /) in passwords.
# DATABASE_URL=postgresql+psycopg2://wastematch:password@localhost:5432/wastematch

# --- OIDC identity provider (REQUIRED - startup fails without these) ---
# auth.py is currently a mock; these define the provider contract the
# real python-jose token validation will use.
OIDC_ISSUER=https://dev-your-tenant.us.auth0.com/
OIDC_CLIENT_ID=replace-with-client-id
OIDC_AUDIENCE=https://api.wastematch.local
# Secret for JWT signing/verification (min 32 chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-min-32-chars

# --- Object storage, S3-compatible (MinIO/LocalStack in dev) ---
# Required with real values in production (startup fails otherwise);
# optional in development, where mock values are used.
AWS_ACCESS_KEY_ID=local-dev-access-key
AWS_SECRET_ACCESS_KEY=local-dev-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=wastematch-documents-dev
# Point at MinIO/LocalStack when running locally; leave unset for AWS S3.
# S3_ENDPOINT_URL=http://localhost:9000
